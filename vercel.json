{
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/versoes", "destination": "/versoes.html" },
    { "source": "/historico", "destination": "/versoes.html" },
    { "source": "/time-machine", "destination": "/versoes.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/painel", "destination": "/admin.html" },
    { "source": "/videos-ads", "destination": "/admin.html" },
    { "source": "/ads", "destination": "/admin.html" },
    { "source": "/catalogo-ads", "destination": "/catalogo-ads.html" },
    { "source": "/todos-produtos", "destination": "/catalogo-ads.html" },
    { "source": "/loja", "destination": "/" },
    { "source": "/resumo", "destination": "/pages/resumo" },
    { "source": "/checkout", "destination": "/pages/resumo" },
    { "source": "/carrinho", "destination": "/pages/carrinho" },
    { "source": "/pages/produto-:id(\\d+).html", "destination": "/api/serve?slug=produto-:id" },
    { "source": "/pages/produto-:id(\\d+)", "destination": "/api/serve?slug=produto-:id" },
    { "source": "/produto-:id(\\d+).html", "destination": "/api/serve?slug=produto-:id" },
    { "source": "/produto-:id(\\d+)", "destination": "/api/serve?slug=produto-:id" },
    { "source": "/produto/:id(\\d+)", "destination": "/api/serve?slug=produto-:id" },
    { "source": "/", "destination": "/api/serve" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/js/(tiktok-cloaker|security-shield|anti-clone-guard)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(img|fonts|videosprodutos|criativos_tiktok_ads|botoesdecarrinhioechat|logopix|logoorderbumps|decalque)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|gif|mp4|webm|woff|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
