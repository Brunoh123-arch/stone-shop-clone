{
  "cleanUrls": true,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/versoes", "dest": "/versoes.html" },
    { "src": "/historico", "dest": "/versoes.html" },
    { "src": "/time-machine", "dest": "/versoes.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/painel", "dest": "/admin.html" },
    { "src": "/resumo", "dest": "/pages/resumo.html" },
    { "src": "/checkout", "dest": "/pages/resumo.html" },
    { "src": "/carrinho", "dest": "/pages/carrinho.html" },
    { "src": "/tracker.js", "dest": "/tracker.js" },
    { "src": "/pages/produto-(\\d+)(?:\\.html)?", "dest": "/api/serve?slug=produto-$1" },
    { "src": "/pages/(.*)", "dest": "/pages/$1" },
    { "src": "/", "dest": "/api/serve" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(img|fonts|videosprodutos|criativos_tiktok_ads|botoesdecarrinhioechat|logopix|logoorderbumps|decalque)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|gif|mp4|webm|woff|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/((?!api|img|css|js|fonts|videosprodutos).*\\.html|^$)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
